@startuml
'https://plantuml.com/class-diagram

skinparam style strictuml

' abstract car on veut toujours instancier un adversaire ou un ami pas un joueur générique...
abstract class Player <<abstract>> {
    'les points de vie sont définies au départ sans avoir besoin de les passer en paramètres
    - m_healthPoints : Integer
    + <<create>> Player(deck : Deck)
    + toString() : String
}

class Friend extends Player {
    + <<create>> Friend(deck : Deck)
}

class Opponent extends Player {
    + <<create>> Opponent(deck : Deck)
}
'le joueur AMI est défini dans le main (car il ne change pas d'une partie à l'autre)
' le deck du joueur AMI est instancié dans le main car il est propre à l'ami
class Game {
    - m_score : Integer
    + <<create>> Game (plateau : GameBord, joueur : Friend, adversaire : Opponent)
    + toString() : String
}

class GameBord {
    ' les constructeurs créent les emplacements de carte -> dans le constructeur ils appellent le constructeur de l'emplacement de carte pour chaque case du tableau
    + <<create>> GameBord()
    + <<create>> GameBord(obstacle : Obstacle)
    + toString() : String
}

class CardSlot {
    - m_slotNumber : Integer
    - m_place : Optional<Card>
    + <<create>> CardSlot (number : Integer)
    + <<create>> CardSlot (number : Integer, obstacle : Obstacle)
    + toString() : String
}

class Deck {
    + <<create>> Deck()
    + shuffle()
    + toString() : String
}

class Card {
    - m_name : String
    - m_healthPoints : Integer
    + <<create>> Card (nom : String)
}

class Animal extends Card {
    - m_attackPoints : Integer
    - m_bloodCost : Integer
    - m_boneCost : Integer
    ' le constructeur de la classe mère est utilisé dans le constructeur enfant
    + <<create>> Animal(name : String, attackPoints : Integer, bloodCost : Integer) : Animal
    + <<create>> Animal(name : String, attackPoints : Integer, bloodCost : Integer, abilities : Ability) : Animal
    + addAbility(ability : Ability)
}

class Obstacle extends Card {
    + <<create>> Card (nom : String)
}

interface Ability {
    + void doAbility
}

class FlyingCard implements Ability {
    - m_card : Card
    + FlyingCard(card : Card)
}

' -> RELATIONS :

' Une partie utilise un plateau et des joueurs
Game "1" *--> "1\n- m_gameboard" GameBord : possède
Game "1" o--> "1\n- m_player" Friend : plays with
'chaque match détruit l'adversaire précédent pour en créer un nouveau, le Main crée la nouvelle instance et la donne à la nouvelle Partie.
Game "1" *--> "1\n- m_opponent" Opponent : affronte

' Le plateau est composé de plusieurs lignes d'emplacements
' On utilise la multiplicité pour remplacer les tableaux Emplacements[]
GameBord "1" *--> "4\n- m_opponentLine" CardSlot
GameBord "1" *--> "4\n- m_centralLine" CardSlot
GameBord "1" *--> "4\n- m_playerLine" CardSlot

' Un joueur possède un Deck
Player "1" *--> "1\n- m_deck" Deck

' Un Deck contient plusieurs cartes (multiplicité *)
Deck "1" o--> "*\n- m_cards" Card

Animal "1" o-->"*\n -m_abilities" Ability
' m_abilities : ArrayList<ability>

' -> NOTES

'PARTIE :
'-> COMPOSITION : 1 plateau de jeu (appelle avec un constructeur (pour placer un obstacle) ou non…
'-> MAIN du

'PLATEAU DE JEU :
'-> 3 lignes : 4 emplacements de cartes
'->

@enduml