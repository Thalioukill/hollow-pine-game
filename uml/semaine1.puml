@startuml
'https://plantuml.com/class-diagram

skinparam style strictuml

/'The GameManager creates the unique instance of Friend.
It launches a while loop for the 3 games.
At each iteration, it instantiates a new Game object (the current game), a new Opponent and a new GameBoard.
At the end of a Game object, if the player has won, the GameManager allows them to add a card to their deck before launching the next Game.'/

class GameManager{
    'we will instantiate the Friend player, the opponent players and the games here...


}

' abstract because we always want to instantiate an opponent or a friend, not a generic player...
abstract class Player <<abstract>> {
    'health points are defined at the start without needing to pass them as parameters
    '- m_healthPoints : Integer
    'bones earned when killing an Animal...
    - m_bonesTokens : Integer
    + <<create>> Player(deck : Deck)
    + placeCard()
    + drawCard()
    + toString() : String
}

class Friend extends Player {
    + <<create>> Friend(deck : Deck)
}

class Opponent extends Player {
    + <<create>> Opponent(deck : Deck)
}
'the FRIEND player is defined in the main (because it does not change from one game to another)
' the FRIEND player's deck is instantiated in the main because it belongs specifically to the friend
class Game {
    - m_score : Integer
    + <<create>> Game (plateau : GameBord, joueur : Friend, adversaire : Opponent)
    '+ setScore(pvAmi : Integer ; pvEnnemi : Integer)
    + gameStatus () : enum
    + checkVictory() : gameStatus
    + playCard(p : Player, cardIndex : Integer, position : Integer)
    + toString() : String
}

class GameBoard {
    ' the constructors create the card slots -> in the constructor they call the card slot constructor for each cell of the array
    + <<create>> GameBoard()
    + <<create>> GameBoard(obstacle : Obstacle)
    ' we search in the hand/Hand for the card to place
    + addCard( c : Integer, position  : Integer) : Boolean
    + toString() : String
}

class CardSlot {
    - m_slotNumber : Integer
    - m_place : Optional<Card>
    + <<create>> CardSlot (number : Integer)
    + <<create>> CardSlot (number : Integer, obstacle : Obstacle)
    + toString() : String
}

class Deck {
    + <<create>> Deck()
    + shuffle()
    + addCard() (card : Card)
    + removeCard(card : Card)
    + toString() : String
}

abstract class Card {
    - m_name : String
    - m_healthPoints : Integer
    + <<create>> Card (nom : String)
}

class Animal extends Card {
    - m_attackPoints : Integer
    - m_bloodCost : Integer
    - m_boneCost : Integer
    ' the constructor of the parent class is used in the child constructor
    + <<create>> Animal(name : String, attackPoints : Integer, bloodCost : Integer) : Animal
    + <<create>> Animal(name : String, attackPoints : Integer, bloodCost : Integer, abilities : Ability) : Animal
    + attack(target : CardSlot)
    + addAbility(ability : Ability)
}

class Obstacle extends Card {
    + <<create>> Card (nom : String)
}

interface Ability {
    + applyAbility(attacker : Animal, target : CardSlot, game : Game)
}

class FlyingAbility implements Ability {
    - m_card : Card
    + FlyingAbility(card : Card)
}


class Hand{
    + addCard(card : Card)
    + removeCard(card : Card)
}

' -> RELATIONSHIPS :

' A game uses a board and players
Game "1" *--> "1\n- m_gameboard" GameBoard : possède
Game "1" o--> "1\n- m_player" Friend : plays with
'each match destroys the previous opponent to create a new one, the Main creates the new instance and gives it to the new Game.
Game "1" *--> "1\n- m_opponent" Opponent : affronte

' The board is composed of several slot lines
' Multiplicity is used to replace the Slot[] arrays
GameBoard "1" *--> "4\n- m_opponentLine" CardSlot
GameBoard "1" *--> "4\n- m_centralLine" CardSlot
GameBoard "1" *--> "4\n- m_playerLine" CardSlot

' A player owns a Deck
Player "1" *--> "1\n- m_deck" Deck

' A Deck contains several cards (multiplicity *)
Deck "1" o--> "*\n- m_cards" Card
' m_hand is an ArrayList of Card but we must check that they belong to the Deck
Hand "1" o-->"*\n -m_hand" Card

Animal "1" o-->"*\n -m_abilities" Ability
' m_abilities : ArrayList<ability>

GameManager "1" o--> "1\n- m_player" Friend : plays with


@enduml