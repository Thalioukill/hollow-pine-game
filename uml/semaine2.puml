class CardStock{
    + CardStock()
    + getCard(name : String) : Animal

}
' CardStock possède 1 ArrayList<cards.Card> et renvoie une copie profonde !!! pas une référence.
CardStock "1" *--> "10..*\n- m_templates" Card : possède

class Deck {
'Au moins 8 ecureuils + on cherche dans le CardStock
    + <<create>> Deck() : Deck
    + shuffle()
    + addCard() (card : Animal)
    + removeCard(card : Animal)
    + toString() : String
    + draw() : Animal
    + getSize() : int
    + isEmpty() : boolean
}

abstract class Card {
    # m_name : String
    # m_healthPoints : Integer
    + <<create>> Card (nom : String, hp : Interger)
    + Card(other Card)
    + getName() : String
    + getHealthPoints() : int
    + {abstract} getAttackPoints() : int
    + takeDamage(amout : int)
    + isDead() : boolean
    + {abstract} isSacrificable() : boolean

}

class Animal extends Card {
' Attributs hérités de la classe MERE !
'    - m_name : String
'    - m_healthPoints : int
' c'est tous des int et pas des Integer parce que l'on ne veut pas qu'il puissent etre null...
    - m_attackPoints :  Integer
    - m_bloodCost :  Integer
    - m_boneCost :  Integer
    ' the constructor of the parent class is used in the child constructor
    + <<create>> Animal(name : String, pv :  Integer, attackPoints :  Integer, bloodCost : Integer, boneCost : Integer) : Animal
    ' Constructeur de COPIE !
    + <<create>> Animal(other : Animal) : Animal
    + addAbility( a : Ability)
    + getAttackPoints() : Integer
    + getBloodCost() : Integer
    + getBloodCost() : Integer
    + isDead() : boolean
    + cloneCard() : Animal;
    + isSacrificable() : boolean
    +takeDamage(amount int, attacker Animal, game Game)
    + attack(targetPosition : Integer, opponent : Player, game : Game)
}


class Obstacle extends Card {
    + <<create>> Obstacle (nom : String, hp : Integer)
    + <<create>> Obstacle(other : Obstacle) : Obstacle
    + isSacrificable() : Boolean
    + getAttackPoints() : Integer
}


interface Ability {
    + applyAbility(attacker : Animal, target : CardSlot, game : Game)
}

class FlyingAbility implements Ability {
    - m_card : Card
    + FlyingAbility(card : Card)
}


class Hand{
    + <<create>> Hand() : Hand
    + addCard(card : Animal)
    + removeCard(card : Card)
    + getSize() : Integer
    + toIndex(letter : Char) : int
    + getCard(letter : Char) : Animal
    + removeCard(letter : Char) : Animal

}

' -> RELATIONSHIPS :

' A game uses a board and players
Game "1" *--> "1\n- m_gameboard" GameBoard : possède
Game "1" o--> "1\n- m_player" User : plays with
'each match destroys the previous opponent to create a new one, the Main creates the new instance and gives it to the new game.Game.
Game "1" *--> "1\n- m_opponent" Opponent : affronte

' The board is composed of several slot lines
' Multiplicity is used to replace the Slot[] arrays
GameBoard "1" *--> "4\n- m_opponentLine" Card
GameBoard "1" *--> "4\n- m_centralLine" Card
GameBoard "1" *--> "4\n- m_playerLine" Card

' A player owns a Deck
Player "1" *--> "1\n- m_deck" Deck

' A Deck contains several cards (multiplicity *)
Deck "1" o--> "*\n- m_cards" Card
' m_hand is an ArrayList of cards.Card but we must check that they belong to the Deck
Hand "1" o-->"*\n -m_hand" Card

Animal "1" o-->"*\n -m_abilities" Ability
' m_abilities : ArrayList<ability>

GameManager "1" o--> "1\n- m_player" User : plays with



'deck -> TOUTES les cartes
@enduml