@startuml
'https://plantuml.com/class-diagram

skinparam style strictuml

/'The game.GameManager creates the unique instance of Friend.
It launches a while loop for the 3 games.
At each iteration, it instantiates a new game.Game object (the current game), a new players.Opponent and a new view.GameBoard.
At the end of a game.Game object, if the player has won, the game.GameManager allows them to add a card to their deck before launching the next game.Game.'/

class main{
    + {static} main( args:String[*] )

    'Friend + deck ?
}

class GameManager{
    'we will instantiate the Friend player(in the main ? ), the opponent players and the games here...
    - User m_player : User
    - m_gamesCount : int;
    - m_gameboard : GameBoard
    - {final} MAX_GAMES : int
    + <<create>> GameManager() : GameManager
    + startCampaign()
    - playNewGame() : boolean
    - offerNewCard()
    - displayFinalResult(victory boolean)
}

'4 cartes qu'il a joués
'4 cartes qu'il va jouer

' abstract because we always want to instantiate an opponent or a friend, not a generic player...
abstract class Player <<abstract>> {
    'health points are defined at the start without needing to pass them as parameters
    '- m_healthPoints : Integer

    'bones earned when killing an cards.Animal...
    # m_bonesToken : Integer
    + <<create>> Player(deck : Deck) : Player
    + placeCard()
    + drawCard()
    ' renvoie 1 Optional<cards.Card>
    + getCardAt(index : Integer) : Card
    + removeCardAt(index : Integer)
    + placeCardAt(card : Card, position : Integer)
    + toString() : String
}
'Chaque player a un tableau de Optional<cards.Card> qui représente les cartes qu'il va jouer, si les emplacements sont déjà pris ALORS il faut PROPOSER UN SACRIFICE !!!!
' Relations d'agrégation/composition
Player "1" *--> "1\n# m_deck" Deck : possède >
Player "1" *--> "0..4\n# m_boardLine" Card : possède >

class User extends Player {
    + <<create>> User(deck : Deck) : User
    + draw()
    + playCardToBoard(handLetter : char, boardPosition : int)
    + takeTurn(dialogue : Interactions)
    + handlePlacement(dialogue : Interactions)
    +

}


User "1" *--> "1\n- m_hand" Hand

class Opponent extends Player {
    + <<create>> Opponent(deck : Deck)
}
'the FRIEND player is defined in the main (because it does not change from one game to another)
' the FRIEND player's deck is instantiated in the main because it belongs specifically to the friend
class Game {
    'La balance : >0 pour l'Ami, <0 pour l'Adversaire
    - m_score : int
    - m_user : User
    - m_opponent : Opponent
    - m_currentPlayer : Player
    - {final} m_dialogue Interactions

    + <<create>> Game (plateau : GameBord, joueur : Friend, adversaire : Opponent)
    '+ setScore(pvAmi : Integer ; pvEnnemi : Integer)
    + runGame() : boolean
    + gameStatus () : enum
    + checkVictory() : gameStatus
    + playCard(p : Player, cardIndex : Integer, position : Integer)
    + toString() : String
    + takeTurn(m_dialogue Interactions, human User)
    + combatPhase(p Player) : int
    - startRound(nbRounds int)
}


