class GameBoard {
    ' the constructors create the card slots -> in the constructor they call the card slot constructor for each cell of the array
    + <<create>> GameBoard()
    + <<create>> GameBoard(obstacle : Obstacle)
    ' we search in the hand/Hand for the card to place
    + addCard( c : Integer, position  : Integer) : Boolean
    + toString() : String
}

