package "view" #FCE4EC {
    class GameBoard {
        - {static} {final} CARD_HEIGHT : int = 9
        - {static} {final} SEP : String
        - {static} {final} PREFIX : String
        - {static} {final} BORDER_EMPTY : String
        - {static} {final} BORDER_CARD : String
        - m_buffer : StringBuilder
        --
        + display(user : User, opponent : Opponent, balance : int, messages : ArrayList<String>) : void
        + displayCombat(user : User, opponent : Opponent, balance : int, messages : ArrayList<String>) : void
        - renderBoardLine(line : BoardLine, color : String, isUserLine : boolean, showScore : boolean, score : int) : void
        - appendCardLayer(optCard : Optional<Card>, layer : int, slot : int, isUser : boolean, color : String) : void
        - getEmptySlotContent(layer : int, slot : int, isUser : boolean) : String
        - getLayerContent(card : Card, layer : int) : String
        - getStatLine(card : Card) : String
        - getAbilityLine(card : Card, index : int) : String
        - truncate(name : String) : String
        - displayHandAndDeck(user : User) : void
        - displayMessages(messages : ArrayList<String>) : void
    }

    class Interactions {
        - m_scanner : Scanner
        --
        + <<create>> Interactions()
        + <<create>> Interactions(scanner : Scanner)
        + askNextAction(human : User, messages : ArrayList<String>) : boolean
        + displayMenu(human : User) : void
        - handlePlacement(human : User, messages : ArrayList<String>) : boolean
        - placeCard(human : User, handIndex : int, messages : ArrayList<String>) : void
        - handleSacrifices(bloodCost : int, human : User) : void
        + draw(joueur : User) : String
        + askPosition(human : User) : int
        + askPositionSacrifice(human : User, alreadySacrificed : ArrayList<Integer>) : int
        + askCardLetter(human : User) : int
        + askConfirmation(s : String) : boolean
        + getAttackMessage(attackerName : String, degats : int) : String
        + offerNewCardChoice(card1 : Animal, card2 : Animal) : Animal
        + askToSacrificeCard(pool : ArrayList<Animal>) : Animal
        + askCardToReceiveAbility(candidates : ArrayList<Animal>, ability : Ability) : Animal
        + displayTransferResult(fromName : String, abilityName : String, toName : String) : void
        + displayGameResult(gameNumber : int) : void
        + displayFinalResult(victory : boolean) : void
        + displayMessage(message : String) : void
        - toIndex(position : int) : int
    }
}

