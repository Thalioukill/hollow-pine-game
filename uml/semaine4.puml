package "view" #FCE4EC {
    class GameBoard {
        - {static} {final} CARD_HEIGHT : Integer = 9
        - {static} {final} SEP : String
        - {static} {final} PREFIX : String
        - {static} {final} BORDER_EMPTY : String
        - {static} {final} BORDER_CARD : String
        - m_buffer : StringBuilder
        --
        + display(user : User, opponent : Opponent, balance : Integer, messages : ArrayList<String>) : void
        + displayCombat(user : User, opponent : Opponent, balance : Integer, messages : ArrayList<String>) : void
        - renderBoardLine(line : BoardLine, color : String, isUserLine : Boolean, showScore : Boolean, score : Integer) : void
        - appendCardLayer(optCard : Optional<Card>, layer : Integer, slot : Integer, isUser : Boolean, color : String) : void
        - getEmptySlotContent(layer : Integer, slot : Integer, isUser : Boolean) : String
        - getLayerContent(card : Card, layer : Integer) : String
        - getStatLine(card : Card) : String
        - getAbilityLine(card : Card, index : Integer) : String
        - truncate(name : String) : String
        - displayHandAndDeck(user : User) : void
        - displayMessages(messages : ArrayList<String>) : void
    }

    class Interactions {
        - m_scanner : Scanner
        --
        + <<create>> Interactions() : Interactions
        + askNextAction(human : User, messages : ArrayList<String>) : Boolean
        + displayMenu(human : User) : void
        - handlePlacement(human : User, messages : ArrayList<String>) : Boolean
        - placeCard(human : User, handIndex : Integer, messages : ArrayList<String>) : void
        - handleSacrifices(bloodCost : Integer, human : User) : void
        + draw(joueur : User) : String
        + askPosition(human : User) : Integer
        + askPositionSacrifice(human : User, alreadySacrificed : ArrayList<Integer>) : Integer
        + askCardLetter(human : User) : Integer
        + askConfirmation(s : String) : Boolean
        + getAttackMessage(attackerName : String, degats : Integer) : String
        + offerNewCardChoice(card1 : Animal, card2 : Animal) : Animal
        + askToSacrificeCard(pool : ArrayList<Animal>) : Animal
        + askCardToReceiveAbility(candidates : ArrayList<Animal>, ability : Ability) : Animal
        + displayTransferResult(fromName : String, abilityName : String, toName : String) : void
        + displayGameResult(gameNumber : Integer) : void
        + displayFinalResult(victory : Boolean) : void
        + displayMessage(message : String) : void
        - displayCardOption(index : Integer, card : Animal)
        - toIndex(position : Integer) : Integer
    }
}

