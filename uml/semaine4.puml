package "model" #E8EAF6 {

    package "model.players" #D1D9FF {
        abstract class Player <<abstract>> {
            # m_boardLine : BoardLine
            # m_deck : ArrayList<Animal>
            --
            + <<create>> Player(deck : ArrayList<Animal>, bord : BoardLine)
            + addCard(card : Animal) : void
            + draw() : Animal
            + getDeckSize() : int
            + isEmpty() : boolean
            + getBoardLineCardAt(index : int) : Optional<Card>
            + combatPhase(opponent : Player) : int
            + placeCardAt(card : Card, position : int) : void
            + getSacrificableCount() : int
            + removeCardAt(index : int) : void
            + getBoardLine() : BoardLine
            + notifyTurnStarted() : void
        }
        class User extends Player {
            - m_hand : ArrayList<Animal>
            - m_deckSave : ArrayList<Animal>
            --
            + <<create>> User(deck : ArrayList<Animal>, bord : BoardLine)
            + addPermanentCard(card : Animal) : void
            + resetForNewGame(freshDeck : ArrayList<Animal>) : void
            + getRewardPool() : ArrayList<String>
            + getSacrificePool() : ArrayList<Animal>
            + {static} deepCopyDeck(source : ArrayList<Animal>) : ArrayList<Animal>
            + getDeckSave() : ArrayList<Animal>
            + transferAbility(from : Animal, ability : Ability, to : Animal) : void
            + shuffle() : void
            + getHandSize() : int
            + getHandCard(index : int) : Animal
            + removeCard(index : int) : Animal
            + getBonesToken() : int
            + addBonesToken() : void
            + getCardAt(position : int) : Optional<Card>
            + hasEnoughBones(test : Animal) : boolean
            + hasEnoughBlood(test : Animal) : boolean
            + spendBones(amount : int) : void
            + sacrifice(position : int) : void
            + playCardToBoard(handIndex : int, boardPosition : int) : void
        }
        class Opponent extends Player {
            - m_previsionLine : BoardLine
            --
            + <<create>> Opponent(deck : ArrayList<Animal>, bord : BoardLine, previsionBoard : BoardLine)
            + applyPrevision() : void
            + placePrevisionCard(position : int) : void
            + opponentAction(positions : List<Integer>) : void
            + getPrevisionCardAt(position : int) : Optional<Card>
            + getPrevisionLine() : BoardLine
        }
    }

    package "model.board" #C8E6C9 {
        class BoardLine {
            - m_slots : ArrayList<Optional<Card>>
            # m_bonesToken : int
            --
            + <<create>> BoardLine()
            + placeCardAt(card : Card, position : int) : void
            + getCardAt(position : int) : Optional<Card>
            + removeCardAt(position : int) : void
            + replaceCard(position : int, newCard : Card) : void
            + moveCard(from : int, to : int) : void
            + isOccupied(position : int) : boolean
            + validateIndex(position : int) : boolean
            + getSacrificableCount() : int
            + clear() : void
            + attack(opponentLine : BoardLine) : int
            + notifyTurnStarted() : void
            + addBonesToken() : void
            + spendBones(amount : int) : void
            + getBonesToken() : int
        }
    }

    package "model.cards" #FFE0B2 {
        abstract class Card <<abstract>> {
            # m_name : String
            # m_healthPoints : Integer
            --
            + <<create>> Card(name : String, hp : Integer)
            + <<create>> Card(other : Card)
            + getName() : String
            + getHealthPoints() : int
            + {abstract} getAttackPoints() : int
            + {abstract} isSacrificable() : boolean
            + {abstract} attack(target : Card) : void
            + isDead() : boolean
            + takeDamage(amount : int) : void
            + isAttacked(amount : int, attacker : Animal) : void
            + isTargetBypassed() : boolean
            + triggerPostAttack(position : int, line : BoardLine) : void
            + triggerStartTurn(position : int, line : BoardLine) : void
            + survivesSacrifice() : boolean
            + hasAbility() : boolean
            + getAbilities() : ArrayList<Ability>
        }
        class Animal extends Card {
            - m_attackPoints : int
            - m_bloodCost : int
            - m_boneCost : int
            - m_abilities : ArrayList<Ability>
            --
            + <<create>> Animal(name : String, attack : int, pv : Integer, blood : int, bone : int)
            + <<create>> Animal(other : Animal)
            + addAbility(a : Ability) : void
            + getAttackPoints() : int
            + getBloodCost() : int
            + getBoneCost() : int
            + cloneAnimal() : Animal
            + revive() : void
            + isSacrificable() : boolean
            + attack(target : Card) : void
            + isAttacked(amount : int, attacker : Animal) : void
            + triggerPostAttack(position : int, line : BoardLine) : void
            + triggerStartTurn(position : int, line : BoardLine) : void
            + survivesSacrifice() : boolean
            + takeDamage(amount : int) : void
            + setHealthPoints(amount : int) : void
            + hasAbility() : boolean
            + hasAnAbility(name : String) : boolean
            + getAbilities() : ArrayList<Ability>
            + getTransferableAbility() : Optional<Ability>
        }
        class Obstacle extends Card {
            --
            + <<create>> Obstacle(name : String, hp : Integer)
            + <<create>> Obstacle(other : Obstacle)
            + isSacrificable() : boolean
            + getAttackPoints() : int
            + attack(target : Card) : void
            + cloneObstacle() : Obstacle
        }
    }

    package "model.stock" #F3E5F5 {
        class AnimalStock {
            - m_templates : ArrayList<Animal>
            + {static} {final} CHAT : String
            + {static} {final} GRIZZLY : String
            + {static} {final} ECUREUIL : String
            + {static} {final} HERMINE : String
            + {static} {final} LOUVETEAU : String
            + {static} {final} LOUP : String
            + {static} {final} PUNAISE : String
            + {static} {final} ELAN : String
            + {static} {final} VIPERE : String
            + {static} {final} PORC_EPIC : String
            + {static} {final} CORBEAU : String
            + {static} {final} MOINEAU : String
            + {static} {final} COYOTE : String
            --
            + <<create>> AnimalStock()
            + getCard(name : String) : Optional<Animal>
            + getAllAnimalNames() : ArrayList<String>
        }
        class ObstacleStock {
            - m_templates : ArrayList<Obstacle>
            + {static} {final} ROCHER : String
            + {static} {final} SAPIN : String
            --
            + <<create>> ObstacleStock()
            + getObstacle(name : String) : Optional<Obstacle>
        }
    }

    package "model.abilities" #E0F7FA {
        abstract class Ability <<abstract>> {
            + {abstract} getName() : String
            + {abstract} getShortName() : String
            + {abstract} cloneAbility() : Ability
            # afterAttack(self : Animal, currentPos : int, line : BoardLine) : void
            # modifyIncomingDamage(damage : int) : int
            # onSacrifice(self : Animal) : boolean
            # onHit(self : Animal, attacker : Animal) : void
            # onAttack(card : Card) : void
            # bypassTarget() : boolean
            # onTurnUpdate(self : Animal, position : int, line : BoardLine) : void
        }
        class GrowthAbility extends Ability {
            - {final} m_finalForm : Animal
            - m_turnsOnBoard : int
            --
            + <<create>> GrowthAbility(finalForm : Animal)
            + onTurnUpdate(self : Animal, position : int, line : BoardLine) : void
            + cloneAbility() : Ability
            + getName() : String
            + getShortName() : String
        }
        class MultipleLivesAbility extends Ability {
            + onSacrifice(self : Animal) : boolean
            + cloneAbility() : Ability
            + getName() : String
            + getShortName() : String
        }
        class RunnerAbility extends Ability {
            + afterAttack(self : Animal, currentPos : int, line : BoardLine) : void
            + cloneAbility() : Ability
            + getName() : String
            + getShortName() : String
        }
        class StinkyAbility extends Ability {
            + modifyIncomingDamage(damage : int) : int
            + cloneAbility() : Ability
            + getName() : String
            + getShortName() : String
        }
        class FlyingAbility extends Ability {
            + bypassTarget() : boolean
            + cloneAbility() : Ability
            + getName() : String
            + getShortName() : String
        }
        class DeathTouchAbility extends Ability {
            + onAttack(card : Card) : void
            + cloneAbility() : Ability
            + getName() : String
            + getShortName() : String
        }
        class SharpQuillsAbility extends Ability {
            + onHit(self : Animal, attacker : Animal) : void
            + cloneAbility() : Ability
            + getName() : String
            + getShortName() : String
        }
    }
}

