package "model" #E8EAF6 {

    package "model.players" #D1D9FF {
        abstract class Player <<abstract>> {
            + <<create>> Player(deck : ArrayList<Animal>, bord : BoardLine)
            + addCard(card : Animal) : void
            + draw() : Animal
            + getDeckSize() : Integer
            + isEmpty() : Boolean
            + getBoardLineCardAt(index : Integer) : Optional<Card>
            + combatPhase(opponent : Player) : Integer
            + placeCardAt(card : Card, position : Integer) : void
            + getSacrificableCount() : Integer
            + removeCardAt(index : Integer) : void
            + getBoardLine() : BoardLine
            + notifyTurnStarted() : void
        }
        Player "1" o--> "1 # m_boardLine" BoardLine : m_boardLine >
        Player "1" o--> "* # m_deck" Animal : m_deck >

        class User extends Player {
            + <<create>> User(deck : ArrayList<Animal>, bord : BoardLine)
            + addPermanentCard(card : Animal) : void
            + resetForNewGame(freshDeck : ArrayList<Animal>) : void
            + getRewardPool() : ArrayList<AnimalType>
            + getSacrificePool() : ArrayList<Animal>
            + {static} deepCopyDeck(source : ArrayList<Animal>) : ArrayList<Animal>
            + getDeckSave() : ArrayList<Animal>
            + transferAbility(from : Animal, ability : Ability, to : Animal) : void
            + shuffle() : void
            + getHandSize() : Integer
            + getHandCard(index : Integer) : Animal
            + removeCard(index : Integer) : Animal
            + getBonesToken() : Integer
            + addBonesToken() : void
            + getCardAt(position : Integer) : Optional<Card>
            + hasEnoughBones(test : Animal) : Boolean
            + hasEnoughBlood(test : Animal) : Boolean
            + spendBones(amount : Integer) : void
            + sacrifice(position : Integer) : void
            + playCardToBoard(handIndex : Integer, boardPosition : Integer) : void
        }
        User "1" *--> "* -m_hand" Animal
        User "1" o--> "* -m_deckSave" Animal

        class Opponent extends Player {
            + <<create>> Opponent(deck : ArrayList<Animal>, bord : BoardLine, previsionBoard : BoardLine)
            + applyPrevision() : void
            + placePrevisionCard(position : Integer) : void
            + opponentAction(positions : List<Integer>) : void
            + getPrevisionCardAt(position : Integer) : Optional<Card>
            + getPrevisionLine() : BoardLine
        }
        Opponent "1" o--> "1 -m_previsionLine" BoardLine
    }

    package "model.board" #C8E6C9 {
        class BoardLine {
            - {final} m_bonesToken : Integer
            --
            + <<create>> BoardLine()
            + placeCardAt(card : Card, position : Integer) : void
            + getCardAt(position : Integer) : Optional<Card>
            + removeCardAt(position : Integer) : void
            + replaceCard(position : Integer, newCard : Card) : void
            + moveCard(from : Integer, to : Integer) : void
            + isOccupied(position : Integer) : Boolean
            + validateIndex(position : Integer) : Boolean
            + getSacrificableCount() : Integer
            + clear() : void
            + attack(opponentLine : BoardLine) : Integer
            + notifyTurnStarted() : void
            + addBonesToken() : void
            + spendBones(amount : Integer) : void
            + getBonesToken() : Integer
        }
        BoardLine "1" *--> "0..4 -m_solts" Card
    }

    package "model.cards" #FFE0B2 {
        abstract class Card <<abstract>> {
            # {final} m_name : String
            # m_healthPoints : Integer
            --
            + <<create>> Card(name : String, hp : Integer)
            + <<create>> Card(other : Card)
            + getName() : String
            + getHealthPoints() : Integer
            + {abstract} getAttackPoints() : Integer
            + {abstract} isSacrificable() : Boolean
            + {abstract} attack(target : Card) : void
            + isDead() : Boolean
            + takeDamage(amount : Integer) : void
            + isAttacked(amount : Integer, attacker : Animal) : void
            + isTargetBypassed() : Boolean
            + triggerPostAttack(position : Integer, line : BoardLine) : void
            + triggerStartTurn(position : Integer, line : BoardLine) : void
            + survivesSacrifice() : Boolean
            + hasAbility() : Boolean
            + getAbilities() : ArrayList<Ability>
        }
        class Animal extends Card {
            - m_attackPoints : Integer
            - m_bloodCost : Integer
            - m_boneCost : Integer
            --
            + <<create>> Animal(name : String, attack : Integer, pv : Integer, blood : Integer, bone : Integer)
            + <<create>> Animal(other : Animal)
            + addAbility(a : Ability) : void
            + getAttackPoints() : Integer
            + getBloodCost() : Integer
            + getBoneCost() : Integer
            + cloneAnimal() : Animal
            + revive() : void
            + isSacrificable() : Boolean
            + attack(target : Card) : void
            + isAttacked(amount : Integer, attacker : Animal) : void
            + triggerPostAttack(position : Integer, line : BoardLine) : void
            + triggerStartTurn(position : Integer, line : BoardLine) : void
            + survivesSacrifice() : Boolean
            + takeDamage(amount : Integer) : void
            + setHealthPoints(amount : Integer) : void
            + hasAbility() : Boolean
            + hasAnAbility(type : AbilityType) : Boolean
            + getAbilities() : ArrayList<Ability>
            + getTransferableAbility() : Optional<Ability>
        }
        Animal "1" *--> "* -m_abilities" Ability
        'c'est une enum... on fait comment ?
        Animal --> AnimalType : m_animalType


        class Obstacle extends Card {
            + <<create>> Obstacle(name : String, hp : Integer)
            + <<create>> Obstacle(other : Obstacle)
            + isSacrificable() : Boolean
            + getAttackPoints() : Integer
            + attack(target : Card) : void
            + cloneObstacle() : Obstacle
            + getObstacleType() : ObstacleType
        }
        Obstacle ..> ObstacleType : -m_type

        enum AnimalType <<enumerate>> {
            HERMINE, LOUP, ECUREUIL, ELAN, LOUVETEAU, VIPERE, GRIZZLY, CORBEAU, PORC_EPIC, PUNAISE, CHAT, COYOTE, MOINEAU
            - m_displayName : String
            --
            + getDisplayName() : String
        }

        enum ObstacleType <<enumerate>> {
            ROCHER, SAPIN
        }

    }

    package "model.stock" #F3E5F5 {
        class AnimalStock {
            + <<create>> AnimalStock()
            + getCard(type : AnimalType) : Optional<Animal>
            + getAllAnimalTypes() : ArrayList<AnimalType>
        }
        AnimalStock "1" *--> "* -m_templates" Animal

        class ObstacleStock {
            - m_templates : ArrayList<Obstacle>
            --
            + <<create>> ObstacleStock()
            + getObstacle(type : ObstacleType) : Optional<Obstacle>
        }
        ObstacleStock "1" *--> "* -m_templates" Obstacle
    }

    package "model.abilities" #E0F7FA {
        abstract class Ability <<abstract>> {
            + {abstract} getType() : AbilityType
            + {abstract} getName() : String
            + {abstract} getShortName() : String
            + {abstract} cloneAbility() : Ability
            # afterAttack(self : Animal, currentPos : Integer, line : BoardLine) : void
            # modifyIncomingDamage(damage : Integer) : Integer
            # onSacrifice(self : Animal) : Boolean
            # onHit(self : Animal, attacker : Animal) : void
            # onAttack(card : Card) : void
            # bypassTarget() : Boolean
            # onTurnUpdate(self : Animal, position : Integer, line : BoardLine) : void
        }

        enum AbilityType {
            FLYING, STINKY, RUNNER, DEATH_TOUCH, SHARP_QUILLS, MULTIPLE_LIVES,GROWTH
        }


        class GrowthAbility extends Ability {
            - m_turnsOnBoard : Integer
            --
            + <<create>> GrowthAbility(finalForm : Animal)
            + onTurnUpdate(self : Animal, position : Integer, line : BoardLine) : void
            + cloneAbility() : Ability
            + getName() : String
            + getShortName() : String
            + getType() : AbilityType
        }
        GrowthAbility "1" o--> "1 - {final} m_finalForm" Animal

        class MultipleLivesAbility extends Ability {
            + onSacrifice(self : Animal) : Boolean
            + cloneAbility() : Ability
            + getName() : String
            + getShortName() : String
            + getType() : AbilityType
        }

        class RunnerAbility extends Ability {
            + afterAttack(self : Animal, currentPos : Integer, line : BoardLine) : void
            + cloneAbility() : Ability
            + getName() : String
            + getShortName() : String
            + getType() : AbilityType
        }

        class StinkyAbility extends Ability {
            + modifyIncomingDamage(damage : Integer) : Integer
            + cloneAbility() : Ability
            + getName() : String
            + getShortName() : String
            + getType() : AbilityType
        }

        class FlyingAbility extends Ability {
            + bypassTarget() : Boolean
            + cloneAbility() : Ability
            + getName() : String
            + getShortName() : String
            + getType() : AbilityType
        }

        class DeathTouchAbility extends Ability {
            + onAttack(card : Card) : void
            + cloneAbility() : Ability
            + getName() : String
            + getShortName() : String
            + getType() : AbilityType
        }

        class SharpQuillsAbility extends Ability {
            + onHit(self : Animal, attacker : Animal) : void
            + cloneAbility() : Ability
            + getName() : String
            + getShortName() : String
            + getType() : AbilityType
        }
    }
}

