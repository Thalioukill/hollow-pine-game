@startuml Inscryption

skinparam style strictuml
skinparam classAttributeIconSize 0
skinparam classFontStyle bold
skinparam ArrowColor #555555
skinparam ClassBorderColor #444444
skinparam ClassBackgroundColor #FAFAFA
skinparam PackageBackgroundColor #F0F4FF
skinparam PackageBorderColor #7986CB
skinparam PackageFontStyle bold
skinparam PackageFontSize 13


package "main" #EEF7EE {
    class Main {
        + {static} main(args : String[]) : void
        - {static} buildPlayerDeck(deck : ArrayList<Animal>) : void
    }
}


package "game" #FFF8E1 {

    class GameManager {
        - m_dialogue : Interactions
        - m_gamesCount : Integer
        - m_user : User
        - m_strategies : ArrayList<GameStrategy> '!!!!!!!!!
        --
        + <<create>> GameManager(dialogue : Interactions, user : User)
        + startCampaign() : void
        - playNewGame() : Boolean
        - initiateOpponent(nbGames : Integer) : Opponent
        - placeUserObstacles(nbGames : Integer) : void
        - placeObstacles(board : HashMap, line : BoardLine) : void
        - resetForNewGame() : void
        - offerNewCard() : void
        - sacrificeStone() : void
        - deduplicateByType(list : ArrayList<Animal>) : ArrayList<Animal>
        - displayGameResult() : void
        - displayFinalResult(victory : Boolean) : void
        - getStrategy(index : Integer) : GameStrategy
    }

    class Game {
        - m_score : Integer
        - m_gameboard : GameBoard '!!!!!
        - m_user : User
        - m_currentPlayer : Player
        - m_dialogue : Interactions
        - m_strategy : GameStrategy
        - m_opponent : Opponent
        - m_turnMessages : ArrayList<String>
        --
        + <<create>> Game(board : GameBoard, player : User, dialogue : Interactions, strat : GameStrategy, opponent : Opponent)
        + runGame() : Boolean
        - takeTurn(dialogue : Interactions, human : User) : void
        + combatPhase(attackedPlayer : Player) : Integer
        - runCombat(attacker : Player, defender : Player, scoreSign : Integer, attackerName : String) : void
    }

    package "game.strategy" #FFF3CD {
        interface GameStrategy <<interface>> {
            + initObstaclesOpponent() : HashMap<Integer, Optional<Obstacle>>
            + initObstaclesUser() : HashMap<Integer, Optional<Obstacle>>
            + getOpponentDeck() : ArrayList<Animal>
            + getPrevisionAction(roundNumber : Integer) : ArrayList<Integer>
            + getInitialPrevision() : ArrayList<Integer>
        }
        class FirstGame implements GameStrategy {
            + getOpponentDeck() : ArrayList<Animal>
            + initObstaclesOpponent() : HashMap<Integer, Optional<Obstacle>>
            + initObstaclesUser() : HashMap<Integer, Optional<Obstacle>>
            + getPrevisionAction(roundNumber : Integer) : ArrayList<Integer>
            + getInitialPrevision() : ArrayList<Integer>
        }
        class SecondGame implements GameStrategy {
            + getOpponentDeck() : ArrayList<Animal>
            + initObstaclesOpponent() : HashMap<Integer, Optional<Obstacle>>
            + initObstaclesUser() : HashMap<Integer, Optional<Obstacle>>
            + getPrevisionAction(roundNumber : Integer) : ArrayList<Integer>
            + getInitialPrevision() : ArrayList<Integer>
        }
        class ThirdGame implements GameStrategy {
            + getOpponentDeck() : ArrayList<Animal>
            + initObstaclesOpponent() : HashMap<Integer, Optional<Obstacle>>
            + initObstaclesUser() : HashMap<Integer, Optional<Obstacle>>
            + getPrevisionAction(roundNumber : Integer) : ArrayList<Integer>
            + getInitialPrevision() : ArrayList<Integer>
        }
    }
}

