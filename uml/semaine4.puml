'  RELATIONSHIPS
' ─────────────────────────────────────────

' main
Main ..> GameManager : creates >
Main ..> User : creates >
Main ..> AnimalStock : uses >

' game
GameManager "1" *--> "1" Interactions : uses >
GameManager "1" o--> "1" User : manages >
GameManager "1" *--> "3" GameStrategy : holds >

Game "1" *--> "1" GameBoard : displays >
Game "1" o--> "1" User : plays with >
Game "1" *--> "1" Opponent : fights >
Game "1" o--> "1" Interactions : interacts >
Game "1" o--> "1" GameStrategy : uses >

' model.players
Player "1" *--> "1" BoardLine : m_boardLine >
Player "1" o--> "*" Animal : m_deck >
User "1" o--> "*" Animal : m_hand >
User "1" o--> "*" Animal : m_deckSave >
Opponent "1" *--> "1" BoardLine : m_previsionLine >

' model.board
BoardLine "1" o--> "0..4" Card : m_slots >

' model.cards
Animal "1" o--> "*" Ability : m_abilities >

' model.stock
AnimalStock "1" *--> "*" Animal : m_templates >
ObstacleStock "1" *--> "*" Obstacle : m_templates >

' model.abilities
GrowthAbility "1" o--> "1" Animal : m_finalForm >

